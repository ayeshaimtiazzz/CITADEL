# Copy this file to .env and fill in your values.
# Everything here is free — Ollama runs fully locally, no API key needed.

# Ollama — runs locally, no key needed. Install from https://ollama.com
# then run: ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cohere — free tier (1000 rerank calls/month), get key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_key_here

# Qdrant — running locally via Docker, no key needed for local instance
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=citadel_chunks

# Langfuse — self-hosted via Docker, get keys from your local Langfuse UI after first run
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000
